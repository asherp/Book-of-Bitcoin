# Glossia WASM build artifacts — generated by build_web.sh / CI, not committed.
web/glossia.js
web/glossia_bg.wasm

# Local clone made by build_web.sh when no glossia checkout is provided.
.glossia-build/

# Deploy-time artifacts of tools/prerender-passages.mjs — the static markdown
# passages and sitemap are generated fresh on every deploy, not committed.
web/passages/
web/sitemap.xml

# Deploy-time release stamp — written by the deploy workflow, not committed.
web/version.json

# The Twitter bot's watermark and replied-to ledger (tools/twitter-bot/) —
# per-deployment runtime state, carried in the Actions cache, not in git.
tools/twitter-bot/state.json
tools/twitter-bot/node_modules/
tools/twitter-bot/package-lock.json
passage.png
